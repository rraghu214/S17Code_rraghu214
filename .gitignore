.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.sqlite
*.sqlite3
*.db
proofs/out/
.DS_Store

# Third-party single-file apps: we do not redistribute Bento's player.
*.bento.html
# Local run stores and scratch workspaces. Anchored to the repo root so it
# does not swallow proofs/runs/, which is evidence rather than scratch.
/.s17/
/runs/

# Model Arena: per-lane runtime state, never shared workspace content.
/arena/data/
/arena/sandbox/
/arena/*.local.env
# Contains S17_CONTROL_TOKEN -- a real (if locally-scoped) secret.
/arena/env/
