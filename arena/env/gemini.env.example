# Copy to gemini.env and fill in. Launch with:
#   uv run --env-file arena/env/gemini.env s17code serve
#
# S17_GATEWAY_MODEL: check your own glc_v5's default Gemini model is actually
# responsive before relying on it -- the newest model available at the time
# (gemini-3.7-flash) was confirmed live to hang for 2+ minutes under high
# demand (a 180s client timeout in glc_v5's GeminiProvider, not a bug -- just
# a long wait when the model itself is degraded). gemini-3.1-flash-lite was
# confirmed reliably fast (~1.5s) and correct on the same account.

S17_PORT=8114
S17_GATEWAY_PROVIDER=gemini
S17_GATEWAY_MODEL=gemini-3.1-flash-lite
S17_WORKSPACE=/absolute/path/to/arena-worktrees/gemini
S17_DATA_DIR=/absolute/path/to/S17Code/arena/data/gemini
S17_SANDBOX_ROOT=/absolute/path/to/S17Code/arena/sandbox/gemini
S17_A2A_GRPC_ENABLED=0
S17_SKILLS_DIR=/absolute/path/to/S17Code/skills
S17_CONTROL_TOKEN=same-value-as-the-other-three-files
GLC_BASE_URL=http://127.0.0.1:8111
