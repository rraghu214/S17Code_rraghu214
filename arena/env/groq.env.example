# Copy to groq.env and fill in. Launch with:
#   uv run --env-file arena/env/groq.env s17code serve
#
# S17_GATEWAY_MODEL: pin explicitly (even to match your account's own
# default) so this lane can't silently change behavior if that default is
# edited later. Check your account's per-model TPM caps before choosing --
# ours (openai/gpt-oss-120b) had only 8K TPM, easily exhausted by a coding
# agent's large prompts. We tried groq/compound-mini for its much larger,
# separate TPM pool, but reverted it: it's an agentic system (Groq's own
# docs: "intelligently and selectively uses built-in tools"), and on the
# real planner prompt it internally delegated to sub-models this account
# didn't have direct access to, causing failures an isolated test never
# revealed. Stuck with the plain model and its real TPM ceiling instead of
# trading it for an unpredictable agentic one.

S17_PORT=8113
S17_GATEWAY_PROVIDER=groq
S17_GATEWAY_MODEL=openai/gpt-oss-120b
S17_WORKSPACE=/absolute/path/to/arena-worktrees/groq
S17_DATA_DIR=/absolute/path/to/S17Code/arena/data/groq
S17_SANDBOX_ROOT=/absolute/path/to/S17Code/arena/sandbox/groq
S17_A2A_GRPC_ENABLED=0
S17_SKILLS_DIR=/absolute/path/to/S17Code/skills
S17_CONTROL_TOKEN=generate-with-python -c "import secrets; print(secrets.token_urlsafe(32))"
GLC_BASE_URL=http://127.0.0.1:8111
