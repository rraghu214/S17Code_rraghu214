# Copy to nvidia.env and fill in. Launch with:
#   uv run --env-file arena/env/nvidia.env s17code serve
#
# S17_GATEWAY_MODEL: check your own glc_v5's configured NVIDIA_MODEL is
# actually live before relying on the default -- ours had been decommissioned
# server-side (confirmed live: HTTP 410 Gone). Pin an explicit model here if so.

S17_PORT=8115
S17_GATEWAY_PROVIDER=nvidia
S17_GATEWAY_MODEL=
S17_WORKSPACE=/absolute/path/to/arena-worktrees/nvidia
S17_DATA_DIR=/absolute/path/to/S17Code/arena/data/nvidia
S17_SANDBOX_ROOT=/absolute/path/to/S17Code/arena/sandbox/nvidia
S17_A2A_GRPC_ENABLED=0
S17_SKILLS_DIR=/absolute/path/to/S17Code/skills
S17_CONTROL_TOKEN=same-value-as-the-other-three-files
GLC_BASE_URL=http://127.0.0.1:8111
